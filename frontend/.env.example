# API Configuration
VITE_API_URL=http://localhost:5000/api

# Stripe Public Key - Get from https://dashboard.stripe.com/apikeys
# NOTE: This is a PUBLIC key, it's safe to share in frontend code
VITE_STRIPE_PUBLIC_KEY=pk_test_YOUR_KEY_HERE

# PayPal Public Client ID - Get from https://developer.paypal.com/dashboard/
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id

# Seller WhatsApp number for automatic post-payment redirect (format: 628xxxx)
VITE_SELLER_WHATSAPP_NUMBER=6281234567890
