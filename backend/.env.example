# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=jualan_online

# Express Server
PORT=5000

# JWT Authentication - Change this in production!
JWT_SECRET=your-super-secret-jwt-key-change-in-production-12345

# Stripe Keys - Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET=sk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# WhatsApp seller notification (background, automatic after payment success)
# Example provider: Fonnte
WA_API_URL=https://api.fonnte.com/send
WA_API_TOKEN=YOUR_WA_API_TOKEN
WA_SELLER_TARGET=6281234567890

# RajaOngkir (for shipping cost calculation)
RAJAONGKIR_API_KEY=your_rajaongkir_api_key
RAJAONGKIR_BASE_URL=https://api.rajaongkir.com/starter
STORE_ORIGIN_CITY=501
